{
  "version": 2,
  "builds": [
    {
      "src": "web/real-estate-demo.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/web/real-estate-demo.html"
    }
  ],
  "headers": [
    {
      "source": "/web/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
